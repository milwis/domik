<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Połączenie ze sterownikiem w sieci lokalnej (LAN, bez chmury). Do internetu aplikacja sięga wyłącznie po
         pogodę (Open-Meteo): wyszukiwanie miejscowości po wpisanej nazwie i prognoza dla wybranej miejscowości. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Wykrywanie braku sieci / zmiany Wi-Fi → ponowne łączenie. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Kafelek kalendarza: wydarzenia z kalendarza urządzenia (tylko odczyt, tylko lokalnie). Zgoda dopiero po
         stuknięciu „Pokaż mój kalendarz”, nigdy przy starcie. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <application
        android:name=".DomikApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Domik">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleInstance"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Domik jako ekran główny (menu → Tablet ścienny → „Domik jako ekran główny”): ten alias pokazuje się
             w ustawieniach „Ekran główny” dopiero po włączeniu przełącznika (setComponentEnabledSetting), stąd
             enabled=false. Autostart po restarcie zapewnia sam system, który uruchamia ekran główny – bez
             RECEIVE_BOOT_COMPLETED (od Androida 10 aplikacje nie startują aktywności z tła). -->
        <activity-alias
            android:name=".HomeAlias"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
