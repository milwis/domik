<?xml version="1.0" encoding="utf-8"?>
<!-- Nic z aplikacji nie trafia do kopii zapasowych w chmurze ani do przeniesienia na inne urządzenie
     (adres sterownika i zaszyfrowany numer seryjny zostają na tym urządzeniu; klucz z Keystore i tak się nie przenosi). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
