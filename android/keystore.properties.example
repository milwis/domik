## Wzór pliku keystore.properties (plik właściwy jest w .gitignore – nigdy nie commitować).
## Jeśli keystore.properties istnieje, build release jest podpisywany; w przeciwnym razie release jest niepodpisany.
storeFile=/path/to/domik-release.jks
storePassword=CHANGE_ME
keyAlias=domik
keyPassword=CHANGE_ME
